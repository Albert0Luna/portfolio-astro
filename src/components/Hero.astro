---
import type { HeroProps } from "../types/index";
type Props = HeroProps;

const {
  name,
  specialty,
  summary,
  email,
  buttonText,
  projectsButtonText = "View Projects",
} = Astro.props;

const pathname = Astro.url.pathname;
const lang = pathname.split("/")[1] || "en";
const availability =
  lang === "es" ? "Disponible para nuevos retos" : "Open to new opportunities";

const typingWords = [
  "RAG & Embeddings",
  "Custom MCP Servers",
  "LLM Agents",
  "Next.js · React · Node.js",
  "Fine-tuning Models",
];
---

<section class="pt-36 pb-24 md:pt-44 md:pb-32 lg:pt-52 lg:pb-40" id="hero">
  <div class="relative">
    <div class="relative z-10">
      <span
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 font-mono text-xs text-emerald-700 backdrop-blur dark:border-emerald-400/20 dark:bg-emerald-400/10 dark:text-emerald-300 animate-[slide-in_0.5s_ease-out]"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"
          ></span>
        </span>
        {availability}
      </span>

      <h1
        class="text-gradient-hero mb-3 font-serif text-5xl font-bold tracking-tight sm:text-6xl md:text-7xl lg:text-8xl animate-[slide-in_0.6s_ease-out]"
      >
        {name}
      </h1>
      <p
        class="text-gradient mb-4 font-serif text-xl leading-tight font-bold tracking-tight sm:text-2xl md:text-3xl lg:text-4xl animate-[slide-in_0.7s_ease-out]"
      >
        {specialty}
      </p>

      <p
        class="caret mb-8 h-6 font-mono text-sm text-slate-500 dark:text-slate-400 animate-[slide-in_0.75s_ease-out]"
        aria-hidden="true"
      >
        <span id="typing-target" data-words={JSON.stringify(typingWords)}
        ></span>
      </p>

      <p
        class="mb-8 md:mb-12 text-base md:text-lg font-normal text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl animate-[slide-in_0.8s_ease-out]"
      >
        {summary}
      </p>

      <div class="flex flex-wrap gap-4 animate-[slide-in_0.9s_ease-out]">
        <a
          class="glow-primary inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 px-8 py-4 text-base font-semibold text-white transition-all duration-300 hover:scale-105 hover:from-indigo-500 hover:to-violet-500"
          href={`mailto:${email}`}
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          {buttonText}
        </a>

        <a
          class="inline-flex items-center gap-2 rounded-full border border-slate-900/15 bg-white/50 px-8 py-4 text-base font-semibold text-slate-700 backdrop-blur transition-all duration-300 hover:scale-105 hover:border-cyan-500/50 hover:bg-cyan-500/10 dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:border-cyan-400/50"
          href="#projects"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
          {projectsButtonText}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Terminal-style typing loop over the AI skill keywords.
  const target = document.getElementById("typing-target");
  const words: string[] = JSON.parse(target?.dataset.words ?? "[]");

  if (target && words.length > 0) {
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reducedMotion) {
      target.textContent = words[0];
    } else {
      let wordIndex = 0;
      let charIndex = 0;
      let deleting = false;

      const tick = () => {
        const word = words[wordIndex];

        if (!deleting) {
          charIndex++;
          target.textContent = word.slice(0, charIndex);
          if (charIndex === word.length) {
            deleting = true;
            setTimeout(tick, 2000);
            return;
          }
          setTimeout(tick, 55 + Math.random() * 45);
        } else {
          charIndex--;
          target.textContent = word.slice(0, charIndex);
          if (charIndex === 0) {
            deleting = false;
            wordIndex = (wordIndex + 1) % words.length;
          }
          setTimeout(tick, 28);
        }
      };

      tick();
    }
  }
</script>
