---
import { ArrowUpRight } from "@lucide/astro";
import type { ProjectProps } from "../types";
import { getLang } from "../lib/i18n";
import Section from "./Section.astro";
import TechBadge from "./TechBadge.astro";
import { Image } from "astro:assets";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
const lang = getLang(Astro.currentLocale);
const sourceLabel = lang === "es" ? "Código" : "Source";
---

<Section
  text="Featured Project"
  textEs="Proyecto Destacado"
  href="projects"
  index="02"
>
  <div class="projects-container">
    {
      projects.map(
        ({ name, summary, date, image, linkPreview, linkSource, stack }) => {
          return (
            <div class="project-item glass-card group mb-12 overflow-hidden">
              <div class="relative z-[1] grid w-full grid-cols-1 overflow-hidden rounded-2xl sm:grid-cols-2 md:min-h-96">
                <div class="flex flex-col justify-between px-6 py-8 md:pt-10">
                  <div>
                    <h3 class="text-gradient mb-1 inline-block font-serif text-3xl font-semibold">
                      {name}
                    </h3>
                    {date && (
                      <p class="mb-4 font-mono text-xs text-slate-500 dark:text-slate-400">
                        {date}
                      </p>
                    )}
                  </div>
                  <p class="text-base text-slate-600 dark:text-neutral">
                    {summary}
                  </p>
                  <div class="mt-5 flex flex-wrap items-center gap-2">
                    {stack.map((item: string) => (
                      <TechBadge tech={item} />
                    ))}
                  </div>
                  <div class="flex gap-5 py-8 pl-1 text-slate-700 dark:text-white">
                    {linkPreview && (
                      <a
                        href={linkPreview}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-1 transition-colors hover:text-indigo-600 hover:underline dark:hover:text-cyan-300"
                      >
                        <span>Demo</span>
                        <ArrowUpRight size={22} />
                      </a>
                    )}
                    {linkSource && (
                      <a
                        href={linkSource}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-1 transition-colors hover:text-indigo-600 hover:underline dark:hover:text-cyan-300"
                      >
                        <span>{sourceLabel}</span>
                        <svg
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.38.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.42.36.79 1.08.79 2.17 0 1.57-.01 2.83-.01 3.22 0 .31.21.66.79.55A11.5 11.5 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5z" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
                <div class="flex items-center justify-center overflow-hidden p-4 sm:p-5">
                  <Image
                    class="h-full w-full rounded-xl object-cover object-center ring-1 ring-slate-900/10 transition-transform duration-500 group-hover:scale-[1.02] dark:ring-white/10"
                    src={image}
                    alt={name}
                    width={900}
                    height={700}
                  />
                </div>
              </div>
            </div>
          );
        }
      )
    }
  </div>
</Section>
