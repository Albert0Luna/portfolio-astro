---
import { ArrowUpRight, Github } from "@lucide/astro";
import type { ProjectProps } from "../types";
import Section from "./Section.astro";
import TechBadge from "./TechBadge.astro";
import { Image } from "astro:assets";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section
  text="Featured Projects"
  textEs="Proyectos Destacados"
  href="projects"
  index="02"
>
  <div class="projects-container">
    {
      projects.map(
        ({ name, summary, image, linkPreview, linkSource, stack }) => {
          return (
            <div class="project-item glass-card group sticky mb-12 overflow-hidden">
              <div class="relative z-[1] grid w-full grid-rows-2 overflow-hidden rounded-2xl sm:grid-cols-2 sm:grid-rows-1 md:h-96">
                <div class="px-6 pt-12">
                  <div>
                    <h3 class="text-gradient mb-5 inline-block font-serif text-3xl font-semibold">
                      {name}
                    </h3>
                  </div>
                  <p class="text-base text-slate-600 dark:text-neutral">
                    {summary}
                  </p>
                  <div class="mt-5 flex flex-wrap items-center gap-2">
                    {stack.map((item: string) => (
                      <TechBadge tech={item} />
                    ))}
                  </div>
                  <div class="flex gap-5 py-8 pl-1 text-slate-700 dark:text-white">
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-1 transition-colors hover:text-indigo-600 hover:underline dark:hover:text-cyan-300"
                    >
                      <span>Demo</span>
                      <ArrowUpRight size={22} />
                    </a>
                    {linkSource && (
                      <a
                        href={linkSource}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-1 transition-colors hover:text-indigo-600 hover:underline dark:hover:text-cyan-300"
                      >
                        <span>Source</span>
                        <Github size={20} />
                      </a>
                    )}
                  </div>
                </div>
                <div class="flex items-end justify-end overflow-hidden">
                  <Image
                    class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-none object-left-top ring-1 ring-slate-900/10 transition-transform duration-500 group-hover:scale-[1.03] dark:ring-white/10 sm:h-[85%] sm:w-full"
                    src={image}
                    alt={name}
                    width="736"
                    height="483"
                  />
                </div>
              </div>
            </div>
          );
        }
      )
    }
  </div>
</Section>
