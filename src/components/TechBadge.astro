---
import { getBadgeDot } from "../lib/badges";

interface Props {
  tech: string;
}

const { tech } = Astro.props;
---

<span
  class="inline-flex items-center gap-1.5 rounded-full border border-slate-900/10 bg-white/60 px-2.5 py-0.5 font-mono text-xs font-medium text-slate-700 backdrop-blur transition-colors hover:border-indigo-500/40 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:hover:border-cyan-400/40"
>
  <span class:list={["h-1.5 w-1.5 rounded-full", getBadgeDot(tech)]}></span>
  {tech}
</span>
