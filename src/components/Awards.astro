---
import { Check, Award } from "@lucide/astro";
import { Image } from "astro:assets";
import type { AwardProps } from "../types";
import Section from "./Section.astro";
import TechBadge from "./TechBadge.astro";

interface Props {
  awards: AwardProps[];
}

const { awards } = Astro.props;
---

<Section
  text="Awards & Recognition"
  textEs="Premios y Reconocimientos"
  href="awards"
  index="03"
>
  <div class="space-y-8">
    {
      awards.map(
        ({
          title,
          project,
          badge,
          issuer,
          date,
          role,
          summary,
          highlights,
          stack,
          image,
          imageAlt,
        }) => (
          <article class="project-item glass-card relative overflow-hidden p-6 md:p-8">
            <span
              class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-400/70 to-transparent"
              aria-hidden="true"
            />

            {/* Top band: portrait photo + award overview with matched heights */}
            <div class="grid items-center gap-6 md:grid-cols-[230px_minmax(0,1fr)] lg:grid-cols-[250px_minmax(0,1fr)] md:gap-8">
              <div class="relative mx-auto w-full max-w-[250px] shrink-0">
                <div
                  class="absolute -inset-3 rounded-3xl bg-gradient-to-br from-amber-400/20 via-indigo-500/20 to-cyan-400/20 blur-2xl"
                  aria-hidden="true"
                />
                <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-amber-400/70 via-indigo-500/50 to-cyan-400/60 p-[2px]">
                  <Image
                    src={image}
                    alt={imageAlt}
                    width={500}
                    height={667}
                    class="aspect-[3/4] w-full rounded-[14px] object-cover object-top"
                  />
                </div>
              </div>

              <div class="flex flex-col gap-3.5">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/35 bg-amber-500/10 px-3 py-1 font-mono text-xs font-semibold text-amber-700 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-300">
                    <Award class="h-3.5 w-3.5" aria-hidden="true" />
                    {badge}
                  </span>
                  <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
                    {issuer} · {date}
                  </span>
                </div>

                <div>
                  <h3 class="text-gradient inline-block font-serif text-3xl font-bold sm:text-4xl">
                    {project}
                  </h3>
                  <p class="mt-1 font-serif text-base font-medium text-indigo-600 dark:text-indigo-400">
                    {title}
                  </p>
                  <p class="mt-0.5 font-mono text-xs text-slate-500 dark:text-slate-400">
                    {role}
                  </p>
                </div>

                <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
                  {summary}
                </p>
              </div>
            </div>

            {/* Bottom band: full-width 2x2 technical highlights + stack badges */}
            <div class="mt-7 border-t border-slate-900/10 pt-6 dark:border-white/10">
              <ul class="grid gap-3.5 sm:grid-cols-2">
                {highlights.map((item) => (
                  <li class="flex items-start gap-2.5 rounded-xl border border-slate-900/5 bg-white/40 p-3.5 text-sm leading-relaxed text-slate-600 dark:border-white/5 dark:bg-white/[0.03] dark:text-slate-300">
                    <Check
                      class="mt-0.5 h-4 w-4 shrink-0 text-cyan-600 dark:text-cyan-400"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-5 flex flex-wrap gap-2">
                {stack.map((tech) => (
                  <TechBadge tech={tech} />
                ))}
              </div>
            </div>
          </article>
        )
      )
    }
  </div>
</Section>
