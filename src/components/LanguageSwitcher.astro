---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../lib/i18n";

interface Props {
  language: Locale;
}

const { language } = Astro.props;
const targetLocale: Locale = language === "en" ? "es" : "en";
const targetUrl = getRelativeLocaleUrl(targetLocale);
const currentLabel = language === "en" ? "English" : "Español";
const targetLabel = language === "en" ? "Español" : "English";
const ariaLabel = language === "es" ? "Cambiar idioma" : "Switch language";
---

<div
  id="language-switcher"
  class="relative flex flex-col items-center justify-center"
>
  <button
    id="language-switcher-button"
    type="button"
    aria-label={ariaLabel}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="language-switcher-menu"
    class="inline-flex items-center gap-2 rounded-xl border border-indigo-500/30 bg-indigo-600/90 px-3.5 py-2 text-xs font-medium text-white transition-colors hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-400/60 dark:border-cyan-400/25 dark:bg-indigo-600/80 dark:hover:bg-indigo-500"
  >
    <span>{currentLabel}</span>
    <svg
      class="h-2.5 w-2.5"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 10 6"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m1 1 4 4 4-4"></path>
    </svg>
  </button>

  <div
    id="language-switcher-menu"
    role="menu"
    class="hidden top-11 right-0 z-10 min-w-full overflow-hidden rounded-xl border border-slate-900/10 bg-white/95 shadow-lg backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/95"
  >
    <a
      href={targetUrl}
      role="menuitem"
      class="block px-4 py-2 text-center text-xs font-medium text-slate-700 transition-colors hover:bg-indigo-500/10 hover:text-indigo-600 dark:text-slate-200 dark:hover:bg-cyan-400/10 dark:hover:text-cyan-300"
    >
      {targetLabel}
    </a>
  </div>
</div>

<script>
  const container = document.getElementById("language-switcher");
  const trigger = document.getElementById("language-switcher-button");
  const menu = document.getElementById("language-switcher-menu");

  if (container && trigger && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      menu.classList.toggle("absolute", open);
      trigger.setAttribute("aria-expanded", `${open}`);
    };

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(menu.classList.contains("hidden"));
    });

    document.addEventListener("click", (e) => {
      if (
        !menu.classList.contains("hidden") &&
        e.target instanceof Node &&
        !container.contains(e.target)
      ) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) {
        setOpen(false);
        trigger.focus();
      }
    });
  }
</script>
