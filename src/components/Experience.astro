---
import { Check, ArrowUpRight } from "@lucide/astro";
import type { ExperienceProps } from "../types";
import Section from "./Section.astro";
import TechBadge from "./TechBadge.astro";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;

const pathname = Astro.url.pathname;
const lang = pathname.split("/")[1] || "en";
const currentLabel = lang === "es" ? "Actual" : "Current";
const currentValues = ["Present", "Actualidad"];
---

<Section
  text="Work Experience"
  textEs="Experiencia Laboral"
  href="experience"
  index="01"
>
  {
    experience.map(
      ({ company, position, startDate, endDate, summary, skills, link }) => {
        const isCurrent = currentValues.includes(endDate);
        return (
          <div class="experience-item glass-card relative mb-8 overflow-hidden p-6 md:p-7">
            <span
              class="absolute inset-y-0 left-0 w-px bg-gradient-to-b from-cyan-400/60 via-indigo-500/40 to-transparent"
              aria-hidden="true"
            />
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="font-serif text-2xl font-semibold text-slate-900 dark:text-white">
                  {link ? (
                    <a
                      href={link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group inline-flex items-center gap-1.5 transition-colors hover:text-indigo-600 dark:hover:text-cyan-300"
                    >
                      {company}
                      <ArrowUpRight class="h-5 w-5 text-indigo-500 opacity-70 transition-opacity group-hover:opacity-100 dark:text-cyan-400" />
                    </a>
                  ) : (
                    company
                  )}
                </h3>
                <h4 class="font-serif text-xl font-medium text-indigo-600 dark:text-indigo-400">
                  {position}
                </h4>
              </div>
              <div class="flex shrink-0 flex-col items-start gap-1.5 sm:items-end">
                {isCurrent && (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-xs font-medium text-emerald-700 dark:border-emerald-400/20 dark:text-emerald-300">
                    <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500" />
                    {currentLabel}
                  </span>
                )}
                <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
                  {startDate} — {endDate}
                </span>
              </div>
            </div>

            {Array.isArray(summary) ? (
              <ul class="mt-4 list-none space-y-3">
                {summary.map((log) => (
                  <li class="flex items-start gap-3 text-base text-slate-600 dark:text-neutral">
                    <Check class="mt-1 h-4 w-4 shrink-0 text-cyan-600 dark:text-cyan-400" />
                    <span>{log}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 text-base text-slate-600 dark:text-neutral">
                {summary}
              </p>
            )}

            {skills && skills.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-2">
                {skills.map((skill) => (
                  <TechBadge tech={skill} />
                ))}
              </div>
            )}
          </div>
        );
      }
    )
  }
</Section>
