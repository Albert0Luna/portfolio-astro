---
import Menu from "../icons/Menu.astro";
import { Image } from "astro:assets";
import { Sun, Moon } from "@lucide/astro";
import type { HeaderProps } from "../types";
import { getLang } from "../lib/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

type Props = HeaderProps;

const { siteLogo, navLinks } = Astro.props;
const lang = getLang(Astro.currentLocale);
const homeHref = lang === "es" ? "/es/" : "/";
const labels = {
  home: lang === "es" ? "Ir al inicio" : "Go to home",
  theme: lang === "es" ? "Cambiar tema de color" : "Toggle color theme",
  menu: lang === "es" ? "Abrir menú de navegación" : "Toggle navigation menu",
};
---

<header class="fixed inset-x-0 top-4 z-50 animate-slide-in px-4">
  <div
    class="relative mx-auto flex max-w-4xl items-center justify-between rounded-2xl border border-slate-900/10 bg-white/70 px-4 py-2.5 shadow-lg shadow-indigo-500/5 backdrop-blur-xl dark:border-white/10 dark:bg-white/5 dark:shadow-black/20"
  >
    <a href={homeHref} aria-label={labels.home} class="group relative">
      <span
        class="absolute -inset-1 rounded-full bg-gradient-to-r from-cyan-400/40 to-violet-500/40 opacity-0 blur transition-opacity duration-300 group-hover:opacity-100"
        aria-hidden="true"></span>
      <Image
        class="relative rounded-full ring-1 ring-slate-900/10 dark:ring-white/20"
        src={siteLogo}
        width="40"
        height="40"
        alt="Gustavo Luna"
      />
    </a>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="theme-toggle"
        class="rounded-lg p-2 text-slate-600 transition-colors hover:bg-slate-900/5 hover:text-slate-900 dark:text-neutral dark:hover:bg-white/10 dark:hover:text-white"
        aria-label={labels.theme}
      >
        <Sun class="hidden h-5 w-5 dark:block" aria-hidden="true" />
        <Moon class="block h-5 w-5 dark:hidden" aria-hidden="true" />
      </button>

      <button
        type="button"
        id="menu-button"
        class="px-1.5 text-slate-600 dark:text-neutral sm:hidden"
        aria-label={labels.menu}
        aria-expanded="false"
        aria-controls="main-menu"
      >
        <Menu />
      </button>

      <nav
        class="absolute top-16 right-0 hidden rounded-2xl border border-slate-900/10 bg-white/90 px-4 py-5 text-slate-600 backdrop-blur-xl dark:border-white/10 dark:bg-black/80 dark:text-neutral sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0 sm:backdrop-blur-none dark:sm:bg-transparent"
        id="main-menu"
      >
        <ul class="items-center gap-2 sm:flex">
          {
            navLinks.map((link) => (
              <li class="relative">
                <a
                  class="nav-item relative block p-2 text-sm font-medium transition-all duration-500 text-slate-600 dark:text-neutral after:absolute after:bottom-0 after:left-2/4 after:h-2 after:w-1 after:-translate-x-2/4 after:text-accent after:opacity-0 after:content-['•'] hover:text-slate-900 dark:hover:text-white"
                  href={link.href}
                >
                  {lang === "es" ? link.textEs : link.text}
                </a>
              </li>
            ))
          }
          <li class="mt-2 sm:mt-0">
            <LanguageSwitcher language={lang} />
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu > ul > li > a");

  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    button?.setAttribute("aria-expanded", `${open}`);
  };

  button?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden") ?? true;
    setMenuOpen(isHidden);
  });

  navItems.forEach((item) => {
    item.addEventListener("click", () => {
      // Only collapse the mobile popover; avoid toggling state on desktop.
      if (window.matchMedia("(max-width: 639px)").matches) {
        setMenuOpen(false);
      }
    });
  });

  const themeToggle = document.querySelector("#theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {
      // Ignore storage errors in restricted environments.
    }
    window.dispatchEvent(new CustomEvent("theme-change", { detail: { isDark } }));
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("href") === `#${entry.target.id}`) {
              item.classList.add(
                "text-slate-900",
                "dark:text-white",
                "md:after:opacity-100"
              );
            } else {
              item.classList.remove(
                "text-slate-900",
                "dark:text-white",
                "md:after:opacity-100"
              );
            }
          });
        }
      });
    },
    { threshold: 0.5 }
  );

  const observeSections = () => {
    document.querySelectorAll("section").forEach((section) => {
      observer.observe(section);
    });
  };

  observeSections();

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "hidden") {
      observer.disconnect();
    } else {
      observeSections();
    }
  });
</script>
