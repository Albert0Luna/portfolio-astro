---
import { ArrowUpRight } from "@lucide/astro";
import type { SiteConfig } from "../types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="relative w-full px-5 pt-5 pb-8 text-center text-slate-600 dark:text-slate-300">
  <span
    class="absolute inset-x-0 top-0 mx-auto h-px w-full max-w-4xl bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"
    aria-hidden="true"></span>
  <ul class="mb-4 flex flex-wrap justify-center gap-x-5 text-xs">
    {
      socialLinks.map(({ text, href }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 px-4 py-3 transition-colors hover:text-indigo-600 dark:hover:text-cyan-300"
          >
            {text}
            <ArrowUpRight size={14} />
          </a>
        </li>
      ))
    }
  </ul>
  <p class="font-mono text-xs text-slate-500 dark:text-slate-400">
    {author} · {currentYear} — built with Astro, powered by AI ⚡
  </p>
</footer>
